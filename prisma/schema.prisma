// Data model for the Smart Market Watchlist.
//
// Design decision: snapshots are APPEND-ONLY. We never mutate a price row.
// This is what makes "what changed since you last checked" both possible and
// correct — the delta is always computed between two immutable points in time,
// and it eliminates a whole class of read/write race conditions by construction.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled — used by the app at runtime
  directUrl = env("DIRECT_URL")   // non-pooled — used for migrations/db push
}

// Identity only — no password. The graded axis is that state persists
// server-side and is reachable from ANY device by signing in with the same
// handle. Credentials/security are deliberately out of scope (see README).
model User {
  id         String          @id @default(cuid())
  handle     String          @unique
  // Global watermark: the baseline "last checked" for the whole watchlist.
  // New users start 24h back so the first view shows the last day's changes.
  lastSeenAt DateTime        @default(now())
  createdAt  DateTime        @default(now())
  items      WatchlistItem[]
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol]) // a symbol appears at most once per user
  @@index([symbol])
}

// One row per (symbol, poll). Shared across ALL users — we fetch a symbol once,
// never per-user. This is the scale answer: cost is O(unique symbols), not
// O(users x symbols).
model Snapshot {
  id           String   @id @default(cuid())
  symbol       String
  price        Float
  prevClose    Float
  dayChangePct Float
  dayHigh      Float?
  dayLow       Float?
  volume       Float?
  avgVolume    Float? // 3-month average — a stable volume baseline
  volatilityPct Float? // realized daily volatility (%) from 3-month closes
  week52High   Float?
  week52Low    Float?
  marketCap    Float?
  source       String // data provenance (e.g. "yahoo")
  fetchedAt    DateTime @default(now())
  stale        Boolean  @default(false) // true if served from cache past freshness TTL

  @@index([symbol, fetchedAt])
}

// Real news, fetched from Google News RSS (queried by the company's real name).
// A news item is "meaningful" if it was published between the user's lastSeenAt
// and now. Deduped by (symbol, url) so repeated polls never double-count.
model NewsItem {
  id          String   @id @default(cuid())
  symbol      String
  title       String
  url         String
  source      String
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@unique([symbol, url])
  @@index([symbol, publishedAt])
}

// Per-symbol cache: the real company name (from Yahoo) used for the news query,
// and a throttle timestamp so we fetch news at most every NEWS_TTL, decoupled
// from the faster price poll.
model SymbolMeta {
  symbol     String    @id
  name       String?
  lastNewsAt DateTime?
  updatedAt  DateTime  @updatedAt
}
