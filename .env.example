# Copy to .env and fill in. Get a free Postgres URL from https://neon.tech
# DATABASE_URL = the POOLED string (host has "-pooler"), used at runtime.
# DIRECT_URL   = same string WITHOUT "-pooler", used for migrations/db push.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Seconds after which a cached quote is shown with a "delayed" badge.
QUOTE_FRESHNESS_TTL_SECONDS=60

# Minutes between news re-fetches per symbol (news moves slower than price).
NEWS_TTL_MINUTES=15

# Comma-separated symbols the poller keeps warm even if no user watches them
# (guarantees the demo always has live data). NSE symbols, no .NS suffix.
POLLER_SEED_SYMBOLS="RELIANCE,TCS,HDFCBANK,INFY,ITC,TATAMOTORS"
